<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8" />
		
		<link rel="stylesheet" href="/_static/index.css" type="text/css" />
		<link rel="stylesheet" href="/_static/custom.css" type="text/css" />
		<link rel="stylesheet" href="/_components/@socketry/syntax/themes/base/syntax.css" type="text/css" />
		
		<script type="importmap">
		{
			"imports": {
				"@socketry/syntax": "/_components/@socketry/syntax/Syntax.js"
			}
		}
		</script>
		
		<!-- Set export flag before any module loads so slide.js skips animations. -->
		<script>window.__PRESENTLY_EXPORT = true;</script>
		
		<script type="module" src="/export.js"></script>
	</head>
	
	<body class="export">
		<?r self.slides.each_with_index do |slide, index| ?>
		<div class="export-page" style="width: #{Presently::ExportPage::SLIDE_WIDTH_PX}px; height: #{Presently::ExportPage::SLIDE_HEIGHT_PX + (self.notes ? Presently::ExportPage::NOTES_HEIGHT_PX : 0)}px;">
			<div class="export-slide-area" style="width: #{Presently::ExportPage::SLIDE_WIDTH_PX}px; height: #{Presently::ExportPage::SLIDE_HEIGHT_PX}px;">
				#{self.render_slide(slide)}
			</div>
			<?r if self.notes ?>
			<div class="export-notes-area" style="width: #{Presently::ExportPage::SLIDE_WIDTH_PX}px; height: #{Presently::ExportPage::NOTES_HEIGHT_PX}px;">
				#{self.render_notes(slide, index + 1)}
			</div>
			<?r end ?>
		</div>
		<?r end ?>
	</body>
</html>
