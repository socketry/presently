<?r caption = self.extract("caption") ?>
<?r translation = self.extract("translation") ?>
<div class="slide-inner image-template">
	#{self.slide_header}
	<div class="slide-image">
		#{self.document}
	</div>
	<?r if caption ?>
		<div class="slide-caption">#{caption}</div>
	<?r end ?>
	<?r if translation ?>
		<div class="slide-translation">
			#{translation}
		</div>
	<?r end ?>
</div>
