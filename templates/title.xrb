<?r subtitle = self.extract("subtitle") ?>
<?r translation = self.extract("translation") ?>
<div class="slide-inner title-template">
	#{self.slide_header}
	<?r if subtitle ?>
		<div class="slide-subtitle">
			#{subtitle}
		</div>
	<?r end ?>
	<?r if translation ?>
		<div class="slide-translation">
			#{translation}
		</div>
	<?r end ?>
</div>
